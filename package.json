{
  "name": "baas-bank-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "start:choreographed": "ng serve --configuration choreographed",
    "build:choreographed": "ng build --configuration production,choreographed",
    "test:e2e:choreographed": "playwright test --config playwright.choreographed.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0",
    "jsdom": "^28.0.0",
    "@playwright/test": "^1.58.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  }
}
